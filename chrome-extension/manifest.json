{
  "manifest_version": 3,
  "name": "Tableau Analysis Assistant",
  "version": "1.0.0",
  "description": "Floating analysis assistant for Tableau dashboards with guided insights and predictions",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:8502/*",
    "https://*.tableau.com/*",
    "https://*.tableauusercontent.com/*",
    "https://*.tableauonline.com/*",
    "https://*.tableauserver.com/*",
    "https://tableau.uberinternal.com/*",
    "https://*.online.tableau.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tableau.com/*",
        "https://*.tableauusercontent.com/*", 
        "https://*.tableauonline.com/*",
        "https://*.tableauserver.com/*",
        "https://tableau.uberinternal.com/*",
        "https://*.online.tableau.com/*"
      ],
      "js": ["network-interceptor-bootstrap.js", "feedback.js", "content-script.js"],
      "css": ["content-style.css", "feedback.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.tableau.com/*",
        "https://*.tableauusercontent.com/*", 
        "https://*.tableauonline.com/*",
        "https://*.tableauserver.com/*",
        "https://tableau.uberinternal.com/*",
        "https://*.online.tableau.com/*"
      ],
      "js": ["content-script.js"],
      "css": ["content-style.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tableau Analysis Assistant"
  },
  "icons": {
    "16": "icons/icon-16.svg",
    "48": "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content-style.css",
        "network-interceptor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
