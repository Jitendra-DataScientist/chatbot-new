<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.analytics.chatbot" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description resource-id="description"/>
    <author name="Developer" email="developer@company.com" organization="Your Company" website="https://www.yourcompany.com"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>http://localhost:8502</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Analysis Assistant</text>
    </resource>
    <resource id="description">
      <text locale="en_US">Floating chat assistant for guided analysis and predictions with Tableau dashboard context</text>
    </resource>
  </resources>
</manifest>